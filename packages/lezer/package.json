{
  "name": "@git-diff-view/lezer",
  "description": "@git-diff-view/lezer",
  "author": "MrWangJustToDo",
  "license": "MIT",
  "version": "0.1.0",
  "types": "index.d.ts",
  "main": "./dist/esm/index.mjs",
  "type": "module",
  "files": [
    "src",
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "gen:type": "dts-bundle-generator -o index.d.ts dist/types/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrWangJustToDo/git-diff-view.git",
    "directory": "packages/lezer"
  },
  "homepage": "https://mrwangjusttodo.github.io/git-diff-view",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "buildOptions": {
    "input": "./src/index.ts",
    "output": [
      {
        "dir": "./dist",
        "entryFileNames": "esm/index.mjs",
        "type": true,
        "format": "esm",
        "sourcemap": true
      }
    ]
  },
  "keywords": [
    "highlight",
    "lezer",
    "virtual dom highlight"
  ],
  "dependencies": {
    "@lezer/common": "^1.5.3",
    "@lezer/cpp": "^1.1.6",
    "@lezer/css": "^1.3.9",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.1.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.8.0",
    "@lezer/php": "^1.0.6",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.3",
    "@lezer/sass": "^1.1.0",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4",
    "@types/hast": "^3.0.0"
  }
}
