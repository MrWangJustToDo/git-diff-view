{
  "name": "@git-diff-view/lynx",
  "description": "ReactLynx DiffView for Lynx (wrap-first Split/Unified)",
  "author": "MrWangJustToDo",
  "license": "MIT",
  "version": "0.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "src",
    "dist",
    "styles",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "gen:type": "echo '[@git-diff-view/lynx] using hand-written index.d.ts'",
    "gen:css": "mkdir -p dist/css && postcss src/tailwind.css -o dist/css/diff-view.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrWangJustToDo/git-diff-view.git",
    "directory": "packages/lynx"
  },
  "homepage": "https://mrwangjusttodo.github.io/git-diff-view",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./index.js"
    },
    "./styles/*": "./dist/css/*",
    "./lowlight-stub": {
      "types": "./src/stubs/lowlight.ts",
      "import": "./src/stubs/lowlight.ts",
      "default": "./src/stubs/lowlight.ts"
    },
    "./package.json": "./package.json"
  },
  "buildOptions": [
    {
      "input": "./src/index.ts",
      "output": [
        {
          "dir": "./dist",
          "entryFileNames": "esm/index.mjs",
          "format": "esm",
          "sourcemap": true
        }
      ]
    },
    {
      "input": "./src/index.ts",
      "output": [
        {
          "dir": "./dist",
          "entryFileNames": "cjs/index.js",
          "format": "cjs",
          "type": true,
          "multiple": true,
          "sourcemap": true
        }
      ]
    }
  ],
  "keywords": [
    "diff component",
    "lynx",
    "reactlynx",
    "git-diff-view"
  ],
  "dependencies": {
    "@git-diff-view/core": "^0.1.8",
    "reactivity-store": "^0.4.1",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@lynx-js/react": "^0.123.0",
    "@lynx-js/tailwind-preset": "^0.5.0",
    "@lynx-js/types": "*",
    "@types/react": "^18.3.8",
    "@types/use-sync-external-store": "^1.5.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "tailwindcss": "3"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.100.0",
    "@lynx-js/types": "*"
  }
}
